# Port the server listens on
PORT=3000

# Where the SQLite database lives
DATA_DIR=./data

# Optional: Discord webhook for reminders (you can also paste it on the Reminders tab)
DISCORD_WEBHOOK_URL=

# Optional: your Discord user ID, so each reminder @mentions you
DISCORD_USER_ID=

# Optional: the address you open the app at
# Each reminder ends with a link back to it.
APP_URL=
